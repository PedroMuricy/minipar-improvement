# Execucao Hibrida (3 Nucleos Locais da CPU + Computador Remoto) - MiniPar 2026.2

func simular_carga(seed, iteracoes) {
    var acc = seed;
    var i = 0;
    while (i < iteracoes) {
        acc = acc + ((i % 7) * (i % 3));
        i = i + 1;
    }
    return acc;
}

func trabalhador_cpu_local(id_nucleo, qtd_atividades) {
    var k = 1;
    var check = 0;
    while (k <= qtd_atividades) {
        check = simular_carga(check, 15000000);
        k = k + 1;
    }
    print("[CPU Local - Nucleo ", id_nucleo, "] Concluiu ", qtd_atividades, " atividades (Check: ", check, ")");
}

func trabalhador_computador_remoto() {
    var canal = c_channel("127.0.0.1", 9000);

    print("[Rede - Fork Remoto] Delegando 40 atividades via c_channel (porta 9000)...");
    send(canal, "40");

    var status_remoto = receive(canal);
    print("[Rede - Fork Remoto] Resposta recebida do Computador 2: ", status_remoto);
}

print("=======================================================");
print("  EXECUCAO PARALELA HIBRIDA: CPU LOCAL + NO REMOTO     ");
print("=======================================================");

var inicio = tempo();

fork trabalhador_cpu_local(1, 40);
fork trabalhador_cpu_local(2, 40);
fork trabalhador_cpu_local(3, 40);
fork trabalhador_computador_remoto();

join;

var fim = tempo();
var total = fim - inicio;

print("=======================================================");
print("Todas as 160 atividades concluidas (CPU + Rede)!");
print("Tempo Total de Execucao Hibrida: ", total, " segundos");
print("=======================================================");