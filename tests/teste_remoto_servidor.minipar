# No Remoto (Computador 2) - MiniPar 2026.2

func simular_carga(seed, iteracoes) {
    var acc = seed;
    var i = 0;
    while (i < iteracoes) {
        acc = acc + ((i % 7) * (i % 3));
        i = i + 1;
    }
    return acc;
}

var canal = c_channel("127.0.0.1", 9000);

print("=== SERVIDOR REMOTO MINIPAR ATIVO ===");
print("Aguardando subtarefa na porta 9000...");

var msg_qtd = receive(canal);
var qtd_atividades = to_number(msg_qtd);

print("[Remoto] Subtarefa recebida: processar ", qtd_atividades, " atividades.");

var k = 1;
var check = 0;
while (k <= qtd_atividades) {
    check = simular_carga(check, 15000000);
    k = k + 1;
}

print("[Remoto] Concluido (Check: ", check, "). Enviando retorno...");
send(canal, "CONCLUIDO");
print("=== SERVIDOR REMOTO FINALIZADO ===");