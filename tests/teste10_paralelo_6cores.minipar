# Teste 10: Paralelismo com 6 Cores (Fork/Join)
# MiniPar 2026.2

func worker_6(id, inicio, fim) {
    var acc = 0;
    var i = inicio;
    while (i < fim) {
        acc = acc + ((i % 5) * (i % 3));
        i = i + 1;
    }
    print("Worker [", id, "] finalizou fatia ", inicio, " a ", fim, ". Subtotal: ", acc);
}

print("==================================================");
print("TESTE 10: Execucao Paralela em 6 Cores (Fork/Join)");
print("==================================================");

print("Disparando 6 tarefas concorrentes...");

fork worker_6(1, 0, 20000000);
fork worker_6(2, 20000000, 40000000);
fork worker_6(3, 40000000, 60000000);
fork worker_6(4, 60000000, 80000000);
fork worker_6(5, 80000000, 100000000);
fork worker_6(6, 100000000, 120000000);

print("Sincronizando tarefas na barreira join...");
join;

print("Concluido: Todas as 6 threads finalizaram!");
print("==================================================");